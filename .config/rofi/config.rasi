configuration {
    combi-modi: "drun,run";
    modi: "combi,calc,wallpaper:sh -c '$HOME/.config/hypr/scripts/wallpaper-selector.sh --rofi \"$@\"' _";
    show-icons: true;
    icon-theme: "Papirus";
    combi-hide-mode-prefix: true;
    kb-mode-next: "Alt+l";
    kb-mode-previous: "Alt+h";
    kb-row-up: "K";
    kb-row-down: "J";
}

@theme "rounded-nord-dark"
